/// One row per web session.
table fct_sessions
	lineageTag: 24dd6356-e5bc-5071-a3a9-bbdfa19cccdd

	column session_key
		dataType: int64
		isHidden
		lineageTag: 20dab388-97c9-53b4-91e9-16c81415509a
		summarizeBy: none
		sourceColumn: session_key

	column customer_key
		dataType: int64
		isHidden
		lineageTag: 621100a6-6de9-5eb1-9025-4b5c7a12eb6d
		summarizeBy: none
		sourceColumn: customer_key

	column session_start_ts
		dataType: dateTime
		isHidden
		lineageTag: 4c319a72-a1b7-50ac-b89a-feaeed914d2d
		summarizeBy: none
		sourceColumn: session_start_ts

	column session_date_key
		dataType: int64
		isHidden
		lineageTag: d3db4ae6-3797-5078-80a7-b73c988d6332
		summarizeBy: none
		sourceColumn: session_date_key

	/// events.traffic_source for a session. Uses a different vocabulary than acquisition_channel (e.g. "Adwords" here vs "Search" there) because it comes from a separate tracking system; the two are not directly comparable.
	column session_traffic_source
		dataType: string
		lineageTag: caffa0c0-2ecb-5ea4-a260-f82c528c120d
		summarizeBy: none
		sourceColumn: session_traffic_source

	column event_count
		dataType: int64
		isHidden
		lineageTag: 822b8d13-80c2-531f-b473-92c09aa1d2c1
		summarizeBy: none
		sourceColumn: event_count

	column has_purchase
		dataType: boolean
		isHidden
		lineageTag: f1662faa-137b-5e79-97e6-abb184327bb6
		summarizeBy: none
		sourceColumn: has_purchase

	partition fct_sessions = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\fct_sessions.parquet"))
				in
				    Source

