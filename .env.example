# Copy to .env and fill in. Never commit .env.

# GCP (see project1-gcp-cube/gcp/SETUP.md)
GCP_PROJECT_ID=
BQ_LOCATION=EU
# Vertex AI endpoint location for Gemini. "eu" is the EU multi-region endpoint
# (data residency in the EU); make gcp-check confirms the model answers there.
VERTEX_LOCATION=eu

# Anthropic (judge + control agent run; needed from Milestone 6)
ANTHROPIC_API_KEY=

# Cube (Milestone 7)
CUBEJS_API_SECRET=
# Absolute path to the Cube service-account key, stored OUTSIDE this repo.
CUBE_SA_KEY_PATH=
